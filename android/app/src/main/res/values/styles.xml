<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MutsumiFocus" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#332925</item>
        <item name="android:navigationBarColor">#221C1A</item>
        <item name="android:colorAccent">@color/mutsumi_accent</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.MutsumiFocus.Setup" parent="Theme.MutsumiFocus">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/mutsumi_paper</item>
    </style>
</resources>
